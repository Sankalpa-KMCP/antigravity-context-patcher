# ====================================================
# Antigravity Context Patcher — .gitignore
# ====================================================

# Node dependencies and package artifacts
node_modules/
package-lock.json
*.vsix
*.zip

# Binary executables and staging
*.exe
*.dll
*.bin
*.new
staging/
backups/
recovery/

# Databases and WAL journal artifacts
*.db
*.db-wal
*.db-shm

# Production apply logs and status files
production-*-status.json
production-*.log
*.log
logs/

# Caches, coverage, and temporary files
coverage/
tmp/
temp/
scratch/
.cache/

# Environment and secrets
.env
.env.*
secrets*
credentials*

# OS and Editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
